// Database schema for the Supabase Postgres database.
//
// The app talks to the database through @supabase/supabase-js, not Prisma.
// This file documents the tables and columns the code uses, and can create
// them on a fresh database with `npm run prisma:push`.
// Compare with your existing database before pushing to it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users sign in with Google only; no password is stored.
model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  senders Sender[]

  @@map("users")
}

// The "From" identity. Without its own SMTP settings, a sender uses the
// server's SMTP account and must use the owner's email address.
model Sender {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  email     String
  smtpHost  String?  @map("smtp_host")
  smtpPort  Int?     @map("smtp_port")
  smtpUser  String?  @map("smtp_user")
  smtpPass  String?  @map("smtp_pass")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  @@index([userId])
  // Also in the database, not expressible here: a partial unique index
  // senders_one_shared_per_user on (user_id) WHERE smtp_host IS NULL
  // (see supabase/schema.sql). Re-create it by hand after `prisma db push`.
  @@map("senders")
}

model Email {
  id             String      @id @default(uuid()) @db.Uuid
  senderId       String      @map("sender_id") @db.Uuid
  recipientEmail String      @map("recipient_email")
  recipientName  String?     @map("recipient_name")
  subject        String
  body           String
  htmlBody       String?     @map("html_body")
  scheduledAt    DateTime    @map("scheduled_at") @db.Timestamptz
  sentAt         DateTime?   @map("sent_at") @db.Timestamptz
  status         EmailStatus @default(SCHEDULED)
  attemptCount   Int         @default(0) @map("attempt_count")
  errorMessage   String?     @map("error_message")
  // Stored as "<userId>:<client key>", so keys are unique per user.
  idempotencyKey String?     @unique @map("idempotency_key")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Restrict, as in supabase/schema.sql: a sender with emails can't be deleted
  // by accident. The API deletes its sent and failed emails first, and refuses
  // while any are unsent.
  sender Sender     @relation(fields: [senderId], references: [id], onDelete: Restrict)
  logs   EmailLog[]

  @@index([status])
  @@index([senderId, scheduledAt])
  @@map("emails")
}

// SCHEDULED: waiting in the queue
// RETRYING:  a send attempt failed (or the hourly limit was hit) and it will be tried again
// SENT:      delivered to the SMTP server
// FAILED:    gave up after all attempts
// Cancelled emails are deleted.
enum EmailStatus {
  SCHEDULED
  RETRYING
  SENT
  FAILED
}

model EmailLog {
  id        String      @id @default(uuid()) @db.Uuid
  emailId   String      @map("email_id") @db.Uuid
  status    EmailStatus
  message   String?
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId, createdAt])
  @@map("email_logs")
}
