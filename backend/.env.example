# ===========================================
# Email Scheduler Backend Configuration
# ===========================================

# Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Required. Signs login tokens; use a long random value, e.g. `openssl rand -hex 32`.
# The server refuses to start without it.
JWT_SECRET=

# Required. The Google OAuth client ID the frontend uses (VITE_GOOGLE_CLIENT_ID).
# Several IDs can be given, comma-separated.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ===========================================
# Supabase (required)
# ===========================================
SUPABASE_URL=https://your-project.supabase.co
# Server-side key; never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only used by the Prisma CLI (`npm run prisma:push`), not by the app.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ===========================================
# Redis (for BullMQ)
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# SMTP (shared account used by senders without their own SMTP settings)
# ===========================================
# Get Ethereal test credentials from https://ethereal.email/
# Port 465 uses implicit TLS; 587 uses STARTTLS.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
ETHEREAL_USER=your-ethereal-user@ethereal.email
ETHEREAL_PASS=your-ethereal-password

# ===========================================
# Worker & rate limiting
# ===========================================

# Run the email worker inside the API process. Set to false when a separate
# worker process runs (`npm run worker`; docker-compose does this).
RUN_WORKER=true

# Jobs processed in parallel per worker process. Default: 5
WORKER_CONCURRENCY=5

# Minimum gap between any two sends, across all workers, in ms. Default: 2000
MIN_DELAY_BETWEEN_EMAILS_MS=2000

# Maximum emails per hour per sender (UTC hour windows). Default: 100
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# ===========================================
# HTTP
# ===========================================

# Allowed browser origins, comma-separated. Use * to allow any origin.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Requests per 15 minutes per client IP on /api. Default: 300
API_RATE_LIMIT_PER_15_MIN=600

# Set when running behind a proxy so the real client IP is used for rate limits:
# a hop count (e.g. 1) or a subnet. Automatically 1 on Vercel.
TRUST_PROXY=
